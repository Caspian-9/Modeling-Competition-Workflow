# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.harness-cache/
.venv/
venv/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and generated runtime files
*.tmp
*.log
~$*

# FAST case-local inputs and disposable run output
cases/*/raw/**
cases/*/questions/*/experiments/*/runs/**
cases/*/paper/build/**

# Historical pre-FAST case runtime
cases/*/data/raw/**
cases/*/initialization/experiments/*/logs/**
cases/*/initialization/experiments/*/.container-output-*/**
cases/*/questions/*/experiments/*/logs/**
cases/*/questions/*/experiments/*/.container-output-*/**
cases/*/agent_jobs/**
cases/*/supervision/**
cases-demo/
